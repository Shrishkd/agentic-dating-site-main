# ==============================================================================
# AgentMatch Environment Configuration
# ==============================================================================

# Database Connection
# SQLite (Default local setup):
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...:5432/postgres"
# Supabase / PostgreSQL (Optional production setup):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Apify Scraping Configuration
# Get your token at: https://console.apify.com/account#/integrations
APIFY_TOKEN="your_apify_token_here"

# Google Gemini API Configuration
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional list of fallback API keys for automatic key rotation (comma-separated):
# GEMINI_API_KEYS="key_1,key_2,key_3"
GEMINI_API_KEYS=""

# Gemini Models
GEMINI_MODEL_ANALYSIS="gemini-3.8-flash"
GEMINI_MODEL_DATING="gemini-3.5-flash-lite"
GEMINI_MODEL_FALLBACK="gemini-3.5-flash-lite"

# Agents dating
DATES_PER_PERSON="4"
DATE_CONCURRENCY="3"
# Optional LinkedIn actor override (default harvestapi/linkedin-profile-scraper)
# LINKEDIN_ACTOR=""

# Rate Limiting Configuration (Free-tier Google AI Studio defaults)
GEMINI_RPM_LIMIT="15"
GEMINI_RPD_LIMIT="1500"
